<?xml version="1.0" encoding="UTF-8"?>
<nmaprun scanner="nmap" args="nmap -oX sample_nmap.xml -sV -O 192.168.56.0/24">
  <host>
    <status state="up" reason="syn-ack"/>
    <address addr="192.168.56.10" addrtype="ipv4"/>
    <hostnames><hostname name="lab-web01.local" type="PTR"/></hostnames>
    <ports>
      <port protocol="tcp" portid="22">
        <state state="open" reason="syn-ack"/>
        <service name="ssh" product="OpenSSH" version="7.4" extrainfo="protocol 2.0"/>
      </port>
      <port protocol="tcp" portid="80">
        <state state="open" reason="syn-ack"/>
        <service name="http" product="Apache" version="2.4.49"/>
      </port>
      <port protocol="tcp" portid="21">
        <state state="open" reason="syn-ack"/>
        <service name="ftp" product="vsftpd" version="2.3.4"/>
      </port>
    </ports>
    <os><osmatch name="Linux 4.X / 5.X" accuracy="95"/></os>
  </host>
  <host>
    <status state="up" reason="syn-ack"/>
    <address addr="192.168.56.11" addrtype="ipv4"/>
    <hostnames><hostname name="lab-db01.local" type="PTR"/></hostnames>
    <ports>
      <port protocol="tcp" portid="3306">
        <state state="open" reason="syn-ack"/>
        <service name="mysql" product="MySQL" version="5.5.28"/>
      </port>
      <port protocol="tcp" portid="22">
        <state state="open" reason="syn-ack"/>
        <service name="ssh" product="OpenSSH" version="6.6.1"/>
      </port>
    </ports>
    <os><osmatch name="Linux 3.X" accuracy="90"/></os>
  </host>
  <host>
    <status state="up" reason="syn-ack"/>
    <address addr="192.168.56.12" addrtype="ipv4"/>
    <hostnames><hostname name="lab-fs01.local" type="PTR"/></hostnames>
    <ports>
      <port protocol="tcp" portid="445">
        <state state="open" reason="syn-ack"/>
        <service name="microsoft-ds" product="Windows Server" version="2008 R2"/>
      </port>
      <port protocol="tcp" portid="21">
        <state state="open" reason="syn-ack"/>
        <service name="ftp" product="ProFTPD" version="1.3.3a"/>
      </port>
    </ports>
    <os><osmatch name="Windows Server 2008 R2" accuracy="93"/></os>
  </host>
</nmaprun>
